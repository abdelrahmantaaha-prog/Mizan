# Mizan — server environment.
#
# None of this is needed to run the app. Without it Mizan is exactly what it
# was: a fully local, offline-first PWA. These variables switch on the optional
# account-sync backend, and the app hides the sync UI when they are absent.
#
# Copy to .env.local for `vercel dev`, or set them in the Vercel dashboard
# under Project → Settings → Environment Variables.

# --- Auth.js -----------------------------------------------------------------
# Generate with:  npx auth secret
AUTH_SECRET=

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials
# → Create credentials → OAuth client ID → Web application).
#
# Authorised redirect URIs must include, for every origin you use:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-project>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set only if Auth.js guesses the wrong public origin (custom domain behind a
# proxy). Vercel normally sets this correctly on its own.
# AUTH_URL=https://your-domain.com/api/auth

# --- Database ----------------------------------------------------------------
# Neon Postgres. Easiest path: Vercel dashboard → Storage → Create Database →
# Neon; the integration injects DATABASE_URL automatically and you can skip
# setting it by hand. The sync table is created on first use.
DATABASE_URL=

# --- Telegram capture (optional) ---------------------------------------------
# Lets you text expenses to a bot and confirm them in the app later. Needs the
# database and auth above, since captures are delivered to a signed-in account.
#
# 1. Talk to @BotFather in Telegram: /newbot, pick a name and a username.
#    It replies with the token.
# 2. Set the three variables below and deploy.
# 3. Point Telegram at the deployment (once, from your machine):
#
#      curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#        -H "Content-Type: application/json" \
#        -d '{"url":"https://<your-project>.vercel.app/api/telegram",
#             "secret_token":"<TELEGRAM_WEBHOOK_SECRET>",
#             "allowed_updates":["message","edited_message"]}'
#
# The secret is yours to invent (any 1–256 chars of A–Z a–z 0–9 _ -). Telegram
# echoes it back on every call, which is what proves a webhook request is
# really from Telegram; without it the route refuses everything.
#
# No AI key belongs here. The bot only stores what it is sent — the app parses
# it in the browser with the user's own key.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Username without the @, used to build the one-tap link in Settings.
TELEGRAM_BOT_USERNAME=
