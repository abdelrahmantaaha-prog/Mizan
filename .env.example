# Mizan — server environment.
#
# None of this is needed to run the app. Without it Mizan is exactly what it
# was: a fully local, offline-first PWA. These variables switch on the optional
# account-sync backend, and the app hides the sync UI when they are absent.
#
# Copy to .env.local for `vercel dev`, or set them in the Vercel dashboard
# under Project → Settings → Environment Variables.

# --- Auth.js -----------------------------------------------------------------
# Generate with:  npx auth secret
AUTH_SECRET=

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials
# → Create credentials → OAuth client ID → Web application).
#
# Authorised redirect URIs must include, for every origin you use:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-project>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set only if Auth.js guesses the wrong public origin (custom domain behind a
# proxy). Vercel normally sets this correctly on its own.
# AUTH_URL=https://your-domain.com/api/auth

# --- Database ----------------------------------------------------------------
# Neon Postgres. Easiest path: Vercel dashboard → Storage → Create Database →
# Neon; the integration injects DATABASE_URL automatically and you can skip
# setting it by hand. The sync table is created on first use.
DATABASE_URL=
